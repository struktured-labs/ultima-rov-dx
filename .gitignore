# ROM files (copyrighted, cannot be in public repo)
*.gb
*.gbc
*.gba
rom/**/*.gb
rom/**/*.gbc

# Everything under rom/ is local-only (ROM dumps, patched builds, saves,
# IPS outputs) except the README and the working/ placeholder.
rom/*
!rom/README.md
!rom/working/
rom/working/*
!rom/working/.gitkeep

# Save data and emulator states (penta-dragon-dx tracked many of these by
# accident; keep them out from the start)
*.sav
*.srm
*.ram
*.rtc
*.ss[0-9]
*.ss
save_states/*
!save_states/README.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Local JavaScript dependencies
node_modules/

# Build artifacts
/dist/

# Temporary files (see AGENTS.md: never use system /tmp)
tmp/
test_output/
logs/

# Debug output
debug_*.png
*.log
tests/results/

# mGBA-emitted screenshots next to ROMs
rom/**/*.png

# Generated outputs (IPS patch, screenshots); regenerate with
# scripts/build_dx.py and scripts/capture_screens.py
rom/*.ips
artifacts/

# Generated branding mockups/tile dumps contain ROM-derived glyphs; never commit
palettes/branding.json
